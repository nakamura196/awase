# Environment variables for awase.
#
# Local development: copy this file to `.env.local` and fill in values.
# Production (GitHub Pages): set each variable as a repository Variable
# (Settings > Secrets and variables > Actions > Variables).

# === Google Analytics 4 (optional) ===
# Public Measurement ID of the GA4 web stream (format G-...). This value is
# public (it is emitted into the page source for every visitor), so it is not a
# secret. Leave it empty to disable analytics (local development, forks).
NEXT_PUBLIC_GA_ID=
